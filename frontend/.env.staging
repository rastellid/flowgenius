# Ambiente STAGING — caricato da Vite con `--mode staging` (vedi package.json).
# APP_ENV guida la build in vite.config.ts (outDir/sourcemap) ed è esposta al
# client come import.meta.env.APP_ENV (envPrefix APP_).
# Non mettere segreti in variabili APP_/VITE_: finiscono nel bundle pubblico.
APP_ENV=staging